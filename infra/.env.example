# Copy to .env and fill in values before: docker compose up -d
# -----------------------------------------------------------------------------
# Warehouse PostgreSQL — use PRIVATE IP on Contabo private network
#   BI_AppServer (Dagster/Airbyte/dbt): 10.0.4.1  public 79.143.178.106
#   BI_DBServer  (Postgres warehouse):    10.0.4.2  public 79.143.176.240
# -----------------------------------------------------------------------------
WAREHOUSE_PG_HOST=10.0.4.2
WAREHOUSE_PG_PORT=5432
WAREHOUSE_PG_USER=datawarehouseuser
WAREHOUSE_PG_PASSWORD=change-me
WAREHOUSE_PG_DATABASE=datawarehouse
# Default Postgres schema for dbt (models use +schema in dbt_project.yml: silver, gold)
DBT_SCHEMA=public

# Dagster nightly job cron (server timezone; default 02:00)
# DAGSTER_ETL_CRON=0 2 * * *

# Dagster -> Airbyte (abctl on same App VPS; port 8000 on the App host)
AIRBYTE_ENABLED=true
# host.docker.internal works with extra_hosts in compose/dagster.yaml; or use 172.17.0.1 on Linux
AIRBYTE_API_HOST=host.docker.internal
AIRBYTE_API_PORT=8000
# abctl public API (required for Mode B with abctl — get via: abctl local credentials)
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# Connection to sync before dbt (from Airbyte UI -> Connection -> ID)
AIRBYTE_CONNECTION_ID=ee3361b7-ebd6-4bb2-8620-5fcc5da55640
# Shown in Dagster asset key (slug: letters, numbers, underscore only)
AIRBYTE_CONNECTION_NAME=BlinkAI_API → datawarehouse
# Optional override for asset key segment (default: slugified CONNECTION_NAME)
# AIRBYTE_CONNECTION_SLUG=BlinkAI_API_datawarehouse
AIRBYTE_ASSET_KEY_PREFIX=airbyte
# Legacy /api/v1 only (abctl returns 403 — leave empty when using CLIENT_ID/SECRET)
AIRBYTE_USERNAME=
AIRBYTE_PASSWORD=

# -----------------------------------------------------------------------------
# Dagster internal metadata DB (separate from the warehouse; stays in Docker)
# -----------------------------------------------------------------------------
DAGSTER_POSTGRES_USER=dagster
DAGSTER_POSTGRES_PASSWORD=change-me-dagster
DAGSTER_POSTGRES_DB=dagster

# -----------------------------------------------------------------------------
# dbt-Workbench metadata DB + runtime paths
# -----------------------------------------------------------------------------
DBTWB_POSTGRES_USER=dbtwb
DBTWB_POSTGRES_PASSWORD=change-me-dbtwb
DBTWB_POSTGRES_DB=dbt_workbench

# These are container paths for dbt-Workbench backend.
DBTWB_DBT_PROJECT_PATH=/workspace/dbt_project
DBTWB_DBT_ARTIFACTS_PATH=/workspace/dbt_artifacts
DBTWB_GIT_REPOS_BASE_PATH=/workspace/repos
# Workbench reads/writes profiles.yml here (set DBT_PROFILES_PATH in compose to this path)
# docker-compose mounts ./dbt -> /workspace/repos/default (UI files) AND ./dbt -> /workspace/dbt_project (dbt run)

# Browser must reach the API on the App VPS (not localhost when you open Workbench remotely)
DBTWB_VITE_API_BASE_URL=http://79.143.178.106:8001

# Optional auth hardening for workbench
DBTWB_AUTH_ENABLED=false
DBTWB_SINGLE_PROJECT_MODE=true
DBTWB_JWT_SECRET_KEY=change_me

# -----------------------------------------------------------------------------
# Contabo Object Storage (S3-compatible) — backups, artifacts, or future lake files
# Region endpoints: https://help.contabo.com/.../s3-connection-settings
#   EU: https://eu2.contabostorage.com
#   Singapore: https://sin1.contabostorage.com
#   US: https://usc1.contabostorage.com
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=https://eu2.contabostorage.com
S3_ACCESS_KEY=778eb635a4e2ca983f59358c20cf8c99
S3_SECRET_KEY=1f6077838b2ebef37dbaed10362144a9
S3_BUCKET=biassets
# Optional; many S3 clients want a region string even for Contabo
S3_REGION=eu2

# -----------------------------------------------------------------------------
# Airbyte (run separately with abctl — see comments in docker-compose.yml)
# If you use Basic Auth on Airbyte proxy:
# AIRBYTE_BASIC_AUTH_USER=
# AIRBYTE_BASIC_AUTH_PASSWORD=
# bootstrap helper env (infra/airbyte/abctl.env.example)
# Airbyte UI host (use public IP or airbyte.local — not the DB private IP)
AIRBYTE_HOST=79.143.178.106
AIRBYTE_PORT=8000
AIRBYTE_INSECURE_COOKIES=true
