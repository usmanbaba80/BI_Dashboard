FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/dagster/app

COPY dagster/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dagster/definitions.py .

# dbt project (mounted at build time from infra/ context)
COPY dbt/ /opt/dagster/dbt/

# Generate manifest.json at image build (no DB connection required for parse)
ENV WAREHOUSE_PG_HOST=build \
    WAREHOUSE_PG_PORT=5432 \
    WAREHOUSE_PG_USER=build \
    WAREHOUSE_PG_PASSWORD=build \
    WAREHOUSE_PG_DATABASE=build \
    DBT_SCHEMA=silver
WORKDIR /opt/dagster/dbt
RUN dbt parse --profiles-dir . --project-dir .

WORKDIR /opt/dagster/app

EXPOSE 4000

HEALTHCHECK --interval=10s --timeout=8s --start-period=60s --retries=12 \
    CMD dagster api grpc-health-check -h 127.0.0.1 -p 4000 || exit 1

CMD ["dagster", "api", "grpc", "-h", "0.0.0.0", "-p", "4000", "-f", "definitions.py"]
